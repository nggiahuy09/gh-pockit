#!/bin/sh
#
# Pre-commit gate: format → analyze. Tests run in CI.
# Enable once per clone: git config core.hooksPath .githooks

set -e

# fvm pins the SDK from .fvmrc; fall back to the dart on PATH where fvm is absent.
if command -v fvm >/dev/null 2>&1; then
  DART="fvm dart"
else
  DART="dart"
fi

fail() {
  echo ""
  echo "✗ pre-commit: $1"
  echo "  Fix: $2"
  echo ""
  exit 1
}

# Check only, never rewrite: a rewriting hook commits something other than what was reviewed.
echo "→ dart format"
$DART format --output=none --set-exit-if-changed . >/dev/null 2>&1 \
  || fail "code is not formatted" "$DART format ."

# Most very_good_analysis rules report at info level; without `--fatal-infos` they block nothing.
echo "→ dart analyze"
$DART analyze --fatal-infos \
  || fail "analyzer reported issues" "$DART fix --apply (or fix them by hand)"

echo "✓ pre-commit ok"
